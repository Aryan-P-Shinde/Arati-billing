# Shared PIN all devices send on every request (header: x-app-pin).
APP_PIN=change-me

# Neon connection string (from your Neon project dashboard -> Connection
# Details). Looks like:
# postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

PORT=3001
